# Repo root — used by scripts/*.ps1 (DB tests, device keys, demo reset) and the Supabase CLI.
# Copy to .env (gitignored).

SUPABASE_PROJECT_REF=
# Database password chosen when the project was created.
SUPABASE_DB_PASSWORD=
# Session pooler / direct connection string from Supabase dashboard -> Connect.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Personal access token for `npx supabase` without interactive login (optional).
SUPABASE_ACCESS_TOKEN=

# Mosquitto install dir (mosquitto_passwd.exe is used by new-device-key.ps1).
MOSQUITTO_DIR=C:\Program Files\mosquitto
