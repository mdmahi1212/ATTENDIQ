# apps/edge — classroom edge node. Secrets here; non-secret tuning (ROI, entry line,
# intervals, thresholds) lives in config.yaml (gitignored; a config.example.yaml ships in Phase 5).

ROOM_CODE=B204
EDGE_CONFIG_PATH=./config.yaml

# edge_devices row id + plaintext key printed ONCE by scripts/new-device-key.ps1 (server stores only SHA-256).
EDGE_DEVICE_ID=
EDGE_DEVICE_KEY=

# Next.js base URL for /api/edge/v1/* (gallery, current session, heartbeat).
API_BASE_URL=https://<app>.vercel.app

# Local Mosquitto (one MQTT user per device, ACL limited to campus/<ROOM_CODE>/#).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=edge-B204
MQTT_TLS=false
MQTT_CA_FILE=

# Camera sources: MJPEG URL, webcam index, or a video file path (for repeatable tests).
GATE_CAMERA_SOURCE=http://192.168.0.21:8080/video
INSIDE_CAMERA_SOURCE=0

# SQLite outbox and model cache.
OUTBOX_PATH=./data/outbox.db
INSIGHTFACE_HOME=./models
YOLO_WEIGHTS=yolov8n.pt

LOG_LEVEL=INFO
