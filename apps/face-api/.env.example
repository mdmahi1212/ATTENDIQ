# apps/face-api — stateless FastAPI + InsightFace. NO database credentials here, by design.

# Shared secret; requests without a matching X-Face-Api-Secret header get 401.
FACE_API_SECRET=

FACE_API_HOST=127.0.0.1
FACE_API_PORT=8000

# InsightFace model pack and where it is cached (default ~/.insightface). models/ is gitignored.
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_HOME=./models
DET_SIZE=640

# Per-image quality gates (reject reasons are returned to the caller).
MIN_FACE_PX=80
MIN_DET_SCORE=0.6
MIN_BLUR_LAPLACIAN_VAR=60
MAX_IMAGE_BYTES=4000000
MAX_IMAGES_PER_REQUEST=12

# The Cloudflare tunnel is chosen by scripts/start-face-api.ps1 parameters (-TunnelName/-PublicUrl, default: quick tunnel).

LOG_LEVEL=INFO
