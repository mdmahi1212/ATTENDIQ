# apps/ingest — MQTT subscriber -> POST /api/edge/v1/events (batched).

# Next.js base URL and this worker's own device key (scripts/new-device-key.ps1).
API_BASE_URL=https://<app>.vercel.app
INGEST_DEVICE_ID=
INGEST_DEVICE_KEY=

# Rooms this worker serves (comma-separated room codes).
ROOM_CODES=B204

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Fixed client id + clean_session=false = persistent QoS 1 session.
MQTT_CLIENT_ID=ingest-1
MQTT_TLS=false
MQTT_CA_FILE=

# Batch flush: whichever comes first.
BATCH_MAX_EVENTS=100
BATCH_MAX_WAIT_MS=1000
# Poll /api/edge/v1/sessions/current and publish campus/<room>/control on change.
SESSION_POLL_SECONDS=15
RETRY_MAX_BACKOFF_SECONDS=60

LOG_LEVEL=INFO
