# apps/simulator — publishes simulation=true events over MQTT for the 30 seeded simulated students.

ROOM_CODE=B204

# Simulator device row (its own key; events carry this source_device_id).
SIM_DEVICE_ID=
SIM_DEVICE_KEY=
# Used to look up the current session id for the room.
API_BASE_URL=https://<app>.vercel.app

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=simulator-B204

LOG_LEVEL=INFO
