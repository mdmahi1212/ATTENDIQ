# apps/web — Next.js (Vercel). Copy to .env.local for local dev; set the same names in Vercel.
# NEXT_PUBLIC_* values are shipped to the browser. Everything else is server-only.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Anon / publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role / secret key. SERVER ONLY (route handlers, server actions via lib/supabase/admin.ts).
# Never prefix with NEXT_PUBLIC_, never put it in the edge, face-api or git.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Public base URL (http://localhost:3000 in dev, https://<app>.vercel.app in prod).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Face API (apps/face-api, reached through the Cloudflare tunnel) ---
FACE_API_URL=https://face.<your-domain>
# Shared secret sent as X-Face-Api-Secret. Must equal FACE_API_SECRET in apps/face-api/.env.
FACE_API_SECRET=

# --- Web Push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact required by the push services.
VAPID_SUBJECT=mailto:admin@example.com

# --- DB webhook -> /api/internal/push-dispatch ---
# Sent by the notifications trigger as X-Webhook-Secret. Same value is stored in private.app_config (not in git).
PUSH_WEBHOOK_SECRET=

# --- Playwright e2e (test accounts on the dev project only) ---
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PROFESSOR_EMAIL=
E2E_PROFESSOR_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
